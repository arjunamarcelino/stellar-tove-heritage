# Template for .env.deploy — copy to .env.deploy and fill in.
# .env.deploy is gitignored (holds the deployer secret); never commit it.

# Network
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org

# Deployer identity (generate: `stellar keys generate <alias> --fund --network testnet`)
DEPLOYER_ALIAS=tove-deployer
DEPLOYER_PUBLIC_KEY=G...
DEPLOYER_SECRET_KEY=S...            # `stellar keys secret <alias>` — TESTNET ONLY

# Canonical wallet WASM hash (from `stellar contract upload`)
WALLET_WASM_HASH=

# Deployed contract IDs (from `stellar contract deploy`)
FACTORY_CONTRACT_ID=
DEMO_WALLET_CONTRACT_ID=
