# Server-only: Express backend URL (do NOT prefix with NEXT_PUBLIC_)
# Used by auth routes and server actions to proxy requests to the backend
API_BASE_URL=https://dev-api.toveheritage.org/api

# Public: this app's URL (for OG images, canonical URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Public: Express backend URL for the ONE direct browser call — the public, tokenless handle
# availability check (GET /v1/handles/check). Called client-side (not via a Server Action) so the
# backend's per-IP throttle keys on the real client IP instead of the Next server's single egress IP.
# The backend must allow CORS from NEXT_PUBLIC_APP_URL for this endpoint. Same origin as API_BASE_URL.
NEXT_PUBLIC_API_BASE_URL=https://dev-api.toveheritage.org/api

# Stellar network configuration (defaults to testnet for development)
# For mainnet: NEXT_PUBLIC_STELLAR_NETWORK=public
# For mainnet: NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
