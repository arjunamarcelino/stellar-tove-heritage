# apps/api — copy to .env and fill locally.
# NEVER commit real values or a raw S... secret key.

PORT=3001

# Stellar / Soroban
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=
STELLAR_NETWORK_PASSPHRASE=

# Server-side signing account. Keep the secret in the Stellar CLI identity store
# (.stellar/) or a secret manager — leave blank in this template.
STELLAR_SOURCE_ACCOUNT=
