# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
BACKOFFICE_API_PREFIX=api/backoffice/v1
CORS_ORIGIN=http://localhost:3001
# Trusted reverse-proxy hop count for correct client-IP resolution (rate limiting).
# 1 = one load balancer in front; 0 = no proxy (use socket IP). Never set to `true`.
TRUST_PROXY_HOPS=1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=tove
DB_PASSWORD=tove_secret
DB_DATABASE=tove_dev

# JWT
JWT_ACCESS_SECRET=<min-32-char-secret>
JWT_REFRESH_SECRET=<min-32-char-secret-different-from-access>
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Refresh Token HMAC (for hashing refresh tokens — NOT the JWT secret)
REFRESH_TOKEN_HMAC_SECRET=<min-32-char-secret-different-from-jwt>

# SEP-10 (Stellar wallet auth) — server signing keypair + domains (config-pinned)
SEP10_SERVER_SIGNING_SECRET=<56-char Stellar secret, S...>
SEP10_HOME_DOMAIN=tove.io
SEP10_WEB_AUTH_DOMAIN=auth.tove.io
SEP10_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
SEP10_CHALLENGE_TIMEOUT=300

# WebAuthn (embedded passkey registration) — RP id + origin allowlist (comma-separated)
WEBAUTHN_RP_ID=tove.io
WEBAUTHN_RP_NAME=Tove
WEBAUTHN_ORIGIN=https://tove.io
WEBAUTHN_CHALLENGE_TIMEOUT=300
WEBAUTHN_MAX_OUTSTANDING=5

# Soroban relayer (embedded smart-wallet deploy) — testnet by default
RELAYER_RPC_URL=https://soroban-testnet.stellar.org
RELAYER_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
RELAYER_SECRET=<56-char Stellar secret, S... — funded testnet relayer account>
# Wallet-factory admin authority (admin-as-source): BOTH the deploy tx source/fee-payer AND signer for
# the admin-gated deploy_wallet (no authorizeEntry). Its G-addr MUST equal on-chain factory.admin()
# (asserted at boot) and the account MUST be XLM-funded. Obtain from the contract owner.
RELAYER_FACTORY_ADMIN_SECRET=<56-char Stellar secret, S... — funded key whose G-addr == factory.admin()>
# Set to false to skip the boot probe (relayer-funded + factory.admin() match) in offline/dev.
RELAYER_BOOT_PROBE=true
RELAYER_WALLET_WASM_HASH=8bfd66f170cdbbecf2090043ec1bb3bfecd3e51bdf54370bc3f7460ad3ba4cc4
# Contract addresses (testnet; mainnet = redeploy → different addresses)
RELAYER_FACTORY_ADDRESS=CAZOVWDKGNPMSF7GJ3FKW7M7WGTQDUKDGC3VNVSN4TQYCXBHT53LHEZC
RELAYER_WEBAUTHN_VERIFIER_ADDRESS=CBRHXSWJPTNSHCLLX2QPA7THILWIY3BKJLPFI4GYJLDNPQRAI2ROOBME
RELAYER_ED25519_VERIFIER_ADDRESS=CDL5YRUNMPGJ42KQFDEKTJBTVBAQGKAGQRJ44DRFBJSMZMBBTACGAQYI
RELAYER_DEPLOY_TIMEOUT_MS=20000
# Passkey-signed USDC transfer (TOV-22). USDC SAC token id is per-environment.
RELAYER_USDC_TOKEN_ADDRESS=<56-char C... USDC SAC contract id for the network>
RELAYER_SUBMIT_TIMEOUT_MS=20000
RELAYER_MAX_TX_FEE=10000000
RELAYER_MAX_TRANSFER_AMOUNT=1000000000000
# Optional dedicated marketplace-settlement source/fee-payer (TOV-177 #386). Empty = share the relayer account
# above. When set, the accept_quote settle path sources/signs/locks on this account's own sequence.
RELAYER_MARKETPLACE_SETTLEMENT_SECRET=
# Export (TOV-40): fraction tokens to drain, as `address:symbol:decimals` triples (symbol/decimals
# optional). Empty until fraction tokens exist. e.g. CABC...:ART:0,CDEF...:XYZ:0
RELAYER_FRACTION_TOKENS=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Throttle (global defaults)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Logging (optional — defaults: debug in dev, info in production)
# LOG_LEVEL=info

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_STORAGE_BUCKET=files

# Fractionalization / FractionToken factory (TOV-233, FR-04.MVP.01)
# Two SEPARATE signing seeds — never commit real values:
#   FRACTION_RELAYER_SECRET      = tx source account (fees + sequence); its own relayer:fraction lock
#   FRACTION_FACTORY_ADMIN_SECRET = signs the factory admin auth entry (must == on-chain factory.admin())
FRACTION_RPC_URL=https://soroban-testnet.stellar.org
FRACTION_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
FRACTION_RELAYER_SECRET=<56-char Stellar secret, S... — funded testnet deploy source>
# Must be the secret for the on-chain factory.admin() account:
#   GCFJFGJDJMMCJFHIL7HDG3VGVTD6NCMNRWFMX6M3PA7YDRHFGF6E3LR5   (boot probe asserts this)
FRACTION_FACTORY_ADMIN_SECRET=<56-char Stellar secret, S... — factory admin key>
# Deployed testnet contract ids (public, non-secret) — from the tove-contract deployment.
FRACTION_FACTORY_ADDRESS=CBIEG2HR66SFX5KG4CPEP6RPZ4JNDGGXY3NDICU37DFSWYPUUTFAHVUK
# Canonical FractionToken WASM hash (TOV-146), read from the deployed factory.wasm_hash().
FRACTION_TOKEN_WASM_HASH=7ad8c08d6e4d72dafba21c1b27b8908e974d725a46aa354491185ae6f26947cd
FRACTION_TOKEN_PROXY_ADMIN=<G... or C... deployed-token upgrade authority>
FRACTION_TREASURY_ADDRESS=<G... or C... platform treasury>
FRACTION_KYC_ALLOWLIST_ADDRESS=CCNR6WXKK42KPM2ACH5M3GET3BMIJNUEEWJYEBQKEHLDI27YT5ZLNHCP
FRACTION_FREEZE_SET_ADDRESS=CAQEMD5FG23AGYK5HGIUW37ZNOD4MFQJ6X27IP6NVCE7R4QZEXRX47UZ
FRACTION_MARKETPLACE_SETTLER_ADDRESS=CDW5RGVHGHC3LDH3XT5Z6KK2OIOVMAH7UALCTKGXWPC5COHD732J3UTR
FRACTION_MINTER_PLACEHOLDER_ADDRESS=<G... or C... placeholder minter (replaced at offering approval)>
FRACTION_USDC_TOKEN_ADDRESS=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
FRACTION_DEPLOY_TIMEOUT_MS=20000
FRACTION_MAX_TOTAL_SUPPLY=1000000
FRACTION_MAX_LOCKUP_DAYS=3650
FRACTION_RECONCILE_ENABLED=true
FRACTION_RECONCILE_CRON=*/1 * * * *
FRACTION_RECONCILE_GRACE_MS=25000
FRACTION_RECONCILE_BATCH=20
FRACTION_BOOT_PROBE=true
# Set true ONLY in dev/test to seed the fixture artist+artworks (never honored in production).
FRACTION_SEED_FIXTURES=false

# --- Secondary-marketplace settlement (TOV-177, FR-06.04+06.05) — accept_quote + async settle worker ---
# RPC/passphrase fall back to the RELAYER_* values when unset. All knobs are Joi-validated (fail-fast at boot).
# MARKETPLACE_SETTLEMENT_RPC_URL=
# MARKETPLACE_SETTLEMENT_NETWORK_PASSPHRASE=
MARKETPLACE_SETTLEMENT_READ_TIMEOUT_MS=5000
MARKETPLACE_SETTLEMENT_ACCEPT_SIG_LEDGERS=120
MARKETPLACE_SETTLEMENT_SETTLE_GRACE_MS=120000
# Lost-enqueue / retry-exhausted reconcile backstop (#382).
MARKETPLACE_SETTLEMENT_RECONCILE_ENABLED=true
MARKETPLACE_SETTLEMENT_RECONCILE_CRON=* * * * *
MARKETPLACE_SETTLEMENT_RECONCILE_GRACE_MS=180000
MARKETPLACE_SETTLEMENT_RECONCILE_BATCH=100

# --- FractionToken balance read (TOV-237, FR-04.MVP.04) — GET /v1/me/holdings ---
# Simulate-only, no signing secret: the synthetic read source pubkey is derived from FRACTION_RELAYER_SECRET.
# RPC/passphrase default to the FRACTION_* values above when unset.
# FRACTION_READ_RPC_URL=https://soroban-testnet.stellar.org
# FRACTION_READ_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
FRACTION_READ_CONCURRENCY=8
FRACTION_READ_TIMEOUT_MS=5000
FRACTION_READ_TOTAL_BUDGET_MS=8000
FRACTION_READ_FANOUT_WARN=200
FRACTION_READ_CACHE_TTL_SECONDS=30

# --- BYOW USDC trustline check (TOV-32, FR-01.11) ---
# The CLASSIC USDC asset a BYOW G-account must trust to receive USDC. Testnet = Circle's testnet issuer.
# USDC_ASSET_ISSUER is REQUIRED (StrKey-validated at boot); set the mainnet issuer before any mainnet cutover.
USDC_ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# RPC/passphrase default to the RELAYER_* values (one must be set for the target network).
# WALLET_TRUSTLINE_RPC_URL=https://soroban-testnet.stellar.org
# WALLET_TRUSTLINE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
WALLET_TRUSTLINE_TIMEOUT_MS=1200

# --- KYC submission + encrypted storage (TOV-28, FR-01.07) ---
# Private Supabase bucket holding the AES-256-GCM ciphertext blobs (ops-provisioned; REQUIRED, no default).
KYC_STORAGE_BUCKET=<private kyc bucket name>
# 32-byte KEK, base64 (REQUIRED). Wraps each per-document DEK + derives the blob-hash HMAC key via HKDF.
KYC_MASTER_KEY=<base64 of 32 random bytes>
KYC_MASTER_KEY_VERSION=1
KYC_SIGNED_URL_TTL=90
# ISO-3166-1 alpha-2 codes eligible to submit (non-empty; a miss → 422 JURISDICTION_NOT_ELIGIBLE).
KYC_JURISDICTION_ALLOWLIST=GB,US,SG
# Server-wide cap on simultaneous in-flight submissions (each buffers ~40MB); excess → 503.
KYC_MAX_CONCURRENT_SUBMISSIONS=4
# Orphan-blob sweeper: deletes bucket objects with no kyc_documents row. Set _ENABLED=false to disable.
KYC_SWEEP_ENABLED=true
KYC_SWEEP_CRON=0 3 * * *
KYC_ORPHAN_GRACE_HOURS=48

# --- On-chain KYCAllowlist admin (TOV-235, FR-04.MVP.03a) ---
# ONE signing seed: KYC_ALLOWLIST_ADMIN_SECRET is BOTH the KYCAllowlist contract admin AND the tx source/fee
# account (admin.require_auth is satisfied by the source-account signature). Non-enumerable (never logged).
# The admin account must be funded with XLM. ⚠ TOV-141 restricts add/remove to a 2-of-3 multi-sig; this
# assumes the deployed contract admin is effectively a single key for the MVP/demo (confirm before prod).
KYC_ALLOWLIST_RPC_URL=https://soroban-testnet.stellar.org
KYC_ALLOWLIST_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
KYC_ALLOWLIST_CONTRACT_ADDRESS=CCNR6WXKK42KPM2ACH5M3GET3BMIJNUEEWJYEBQKEHLDI27YT5ZLNHCP
KYC_ALLOWLIST_ADMIN_SECRET=<56-char Stellar secret, S... — KYCAllowlist contract admin + tx source>
KYC_ALLOWLIST_SUBMIT_TIMEOUT_MS=15000
# Small synchronous batch: serialized submission is ~one ledger-close (~5-6s) per item. Max 10.
KYC_ALLOWLIST_MAX_BATCH=5
KYC_ALLOWLIST_BOOT_PROBE=true

# --- Offering escrow deploy + multi-sig approval (TOV-154, FR-05.02) ---
# ONE signing seed: OFFERING_ESCROW_ADMIN_SECRET is BOTH the escrow admin AND the tx source/fee account
# (admin-as-source: admin.require_auth is satisfied by the source-account signature). Non-enumerable
# (never logged). The admin account MUST be funded with XLM. The boot probe (OFFERING_ESCROW_BOOT_PROBE)
# asserts the derived deployer pubkey is funded on boot.
OFFERING_ESCROW_RPC_URL=https://soroban-testnet.stellar.org
OFFERING_ESCROW_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
OFFERING_ESCROW_ADMIN_SECRET=<56-char Stellar secret, S... — escrow admin + tx source; MUST be funded>
# Canonical offering-escrow WASM hash (hex 64) — read from the deployed tove-offering-escrow contract.
OFFERING_ESCROW_WASM_HASH=d171963cff32da75c385c02724793d37e187142564582c8eda82deddf23bfc86
# Deployed testnet contract ids (public, non-secret).
OFFERING_ESCROW_USDC_ADDRESS=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# treasury may be a classic (G) or contract (C) address — reuse the FRACTION_TREASURY value.
OFFERING_ESCROW_TREASURY_ADDRESS=<G... or C... platform treasury>
OFFERING_ESCROW_POLL_TIMEOUT_MS=30000
OFFERING_ESCROW_MAX_TX_FEE=10000000
OFFERING_ESCROW_BOOT_PROBE=true
# Window-open + expiry reconcile sweeper.
OFFERING_ESCROW_RECONCILE_ENABLED=true
OFFERING_ESCROW_RECONCILE_CRON=*/1 * * * *
OFFERING_ESCROW_RECONCILE_BATCH=20
OFFERING_ESCROW_DEPLOY_GRACE_MS=120000
# Approval quorum: CSV roster of admin UUIDs ("the 3"; must be distinct and >= threshold), the threshold
# ("the 2"), and the approval expiry window in days. Factory asserts threshold <= roster + distinct UUIDs.
OFFERING_APPROVAL_SIGNERS=<uuid1,uuid2,uuid3>
OFFERING_APPROVAL_THRESHOLD=2
OFFERING_APPROVAL_TTL_DAYS=7

# --- Beneficiary designation (TOV-31, FR-01.10) ---
# Erasure-reconcile backstop: a repeatable job that hard-deletes beneficiaries whose owning user is
# soft-deleted (safety net for the best-effort per-account purge). Set _ENABLED=false to disable.
BENEFICIARY_ERASURE_SWEEP_ENABLED=true
BENEFICIARY_ERASURE_SWEEP_CRON=0 4 * * *
